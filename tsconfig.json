{
  // Web app (runs in the browser). The game server has its own: worker/tsconfig.json
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": ["client/src", "shared", "vite.config.ts"]
}
