{
  // Game server (runs on Cloudflare). Types come from `npx wrangler types`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2024"],
    "types": []
  },
  "include": [".", "../shared"]
}
